# ─────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smoothtravel
POSTGRES_USER=smoothtravel
POSTGRES_PASSWORD=smoothtravel

# ─────────────────────────────────────────
# Redis
# ─────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─────────────────────────────────────────
# SMTP (email OTP)
# Dev: point to a local mock server (e.g. Mailpit on port 1025)
# Prod: use a real SMTP provider (e.g. Resend, Brevo, SES)
# ─────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@smoothtravel.com

# ─────────────────────────────────────────
# JWT — RSA keys (production only)
# Leave empty in dev: the keys embedded in src/main/resources are used.
# In prod: provide the absolute path to the .pem files on the server.
# ─────────────────────────────────────────
JWT_PUBLIC_KEY_LOCATION=
JWT_PRIVATE_KEY_LOCATION=

# ─────────────────────────────────────────
# WebAuthn / Passkeys (production only)
# In dev: localhost / http://localhost:3000 are used by default.
# WEBAUTHN_RP_ID   : application domain (e.g. smoothtravel.app)
# WEBAUTHN_RP_NAME : name displayed in the browser prompt
# WEBAUTHN_ORIGIN  : exact frontend origin (e.g. https://smoothtravel.app)
# ─────────────────────────────────────────
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=SmoothTravel
WEBAUTHN_ORIGIN=

# ─────────────────────────────────────────
# CORS (production only)
# Frontend URL allowed to call the API (e.g. https://smoothtravel.app)
# ─────────────────────────────────────────
CORS_ORIGINS=
